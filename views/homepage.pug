doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title
    link(rel='stylesheet', href='/css/style.css')
    style.
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
      }
      .btn {
        display: inline-block;
        padding: 0.5rem 1rem;
        margin: 1rem 0;
        background-color: #0085ff;
        color: white;
        text-decoration: none;
        border-radius: 5px;
      }
      .btn:hover {
        background-color: #0062cc;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
      }
      th, td {
        padding: 0.75rem;
        text-align: left;
        border-bottom: 1px solid #ddd;
      }
      th {
        background-color: #f8f9fa;
        font-weight: bold;
      }
  body
    .container
      h1 Contact List
      a.btn(href='/update-cobj') Add to this table
      
      if data && data.length > 0
        table
          thead
            tr
              th ID
              th First Name
              th Last Name
              th Email
              th Phone
          tbody
            each contact in data
              tr
                td= contact.id
                td= contact.properties.firstname || 'N/A'
                td= contact.properties.lastname || 'N/A'
                td= contact.properties.email || 'N/A'
                td= contact.properties.phone || 'N/A'
      else
        p No contacts found. 
          a(href='/update-cobj') Create one!
